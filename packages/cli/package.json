{
  "name": "@eve-pdpa-extension/cli",
  "version": "0.0.0",
  "description": "Scan JSONL, CSV and LINE Official Account exports for Thai personal data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintelligence-dev/eve-pdpa-extension.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "eve-pdpa": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eve-pdpa-extension/core": "workspace:*"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-legal.mjs",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
