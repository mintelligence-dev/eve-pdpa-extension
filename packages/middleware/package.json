{
  "name": "@eve-pdpa-extension/middleware",
  "version": "0.0.0",
  "private": true,
  "description": "Express, Hono and Next.js middleware that protects Thai personal data in chat request bodies before your handler, and in JSON replies on the way out.",
  "keywords": [
    "pdpa",
    "thai",
    "pii",
    "privacy",
    "personal-data",
    "redact",
    "middleware",
    "express",
    "hono",
    "nextjs"
  ],
  "bugs": {
    "url": "https://github.com/mintelligence-dev/eve-pdpa-extension/issues"
  },
  "license": "MIT",
  "author": "M Intelligence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintelligence-dev/eve-pdpa-extension.git",
    "directory": "packages/middleware"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eve-pdpa-extension/core": "workspace:^"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-legal.mjs",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.2.1",
    "hono": "4.13.17",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
