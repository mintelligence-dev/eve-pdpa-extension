# What `vercel deploy` uploads from this repository: only what building
# apps/webhook needs. Everything else stays here — above all docs/, notes and
# anything else outside git, which the CLI would otherwise upload with the rest.
/*
!/apps
# Only the app being deployed: another app's local state (apps/pdpa-agent/.eve
# holds an agent's runs) must not go up with it.
/apps/*
!/apps/webhook
!/packages
!/internal
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.npmrc
!/tsconfig.base.json
!/tsconfig.json

# Rebuilt or reinstalled on Vercel.
**/node_modules
**/dist
**/.size
**/coverage
