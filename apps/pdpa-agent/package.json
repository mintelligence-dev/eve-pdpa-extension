{
  "name": "@eve-pdpa-extension/pdpa-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Template eve agent: every layer of @eve-pdpa-extension/eve wired up — channel, tools, model and Slack replies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev",
    "dev:mock": "PDPA_TEMPLATE_MOCK_MODEL=1 eve dev --no-default-extensions",
    "build": "eve build",
    "start": "eve start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/pdpa-agent/test"
  },
  "dependencies": {
    "@eve-pdpa-extension/core": "workspace:^",
    "@eve-pdpa-extension/eve": "workspace:^",
    "@eve-pdpa-extension/http": "workspace:^",
    "ai": "7.0.143",
    "eve": "0.80.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
