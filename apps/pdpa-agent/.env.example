# Copy to .env.local for `eve dev`, or set in the Vercel project. Never commit real values.

# openssl rand -hex 32 — each its own value. Production refuses to start without them.
PDPA_HMAC_KEY=
PDPA_SESSION_KEY=

# Shared token store. Production refuses to start without it: the policy tokenises.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Slack app (api.slack.com/apps): Bot User OAuth Token and Signing Secret.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# The real model, through the Vercel AI Gateway. On Vercel, OIDC works without it.
AI_GATEWAY_API_KEY=

# 1 = eve's scripted mock model: no key needed.
PDPA_TEMPLATE_MOCK_MODEL=
# Optional, absolute paths: one JSON line per model call / per audit event.
# PDPA_TEMPLATE_RECORD_FILE=
# PDPA_TEMPLATE_AUDIT_FILE=
