# Copy to .env.local and fill in. Never commit real values.

# LINE Messaging API — LINE Developers console → your channel.
# Leave both empty to run without LINE: the /eve/v1/line route is switched off.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# The real model goes through the Vercel AI Gateway (agent/agent.ts).
# Locally, `eve dev` can also use credentials saved with /login.
AI_GATEWAY_API_KEY=

# 1 = answer with eve's scripted mock model instead: no key needed.
PDPA_EXAMPLE_MOCK_MODEL=

# Optional. Absolute paths. One JSON line per model call / per audit event.
# PDPA_EXAMPLE_RECORD_FILE=
# PDPA_EXAMPLE_AUDIT_FILE=
