# Copy to .env.local and fill in. eve add writes the two PDPA keys there for you.

# Any two secrets of 32 bytes or more: openssl rand -hex 32
PDPA_HMAC_KEY=
PDPA_SESSION_KEY=

# The model goes through Vercel AI Gateway. Run `npx eve link` to pull credentials,
# or set a key from https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
